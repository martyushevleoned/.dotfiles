{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["network", "pulseaudio", "backlight", "battery", "clock"],
    "hyprland/workspaces": {
        "format": "{icon}",
        "icons": { "1": "一", "2": "二", "3": "三", "4": "四", "5": "五" }
    },
    "network": { "format-wifi": " {essid}", "format-disconnected": "󰤮" },
    "pulseaudio": { "format": "{icon} {volume}%", "format-icons": ["", "", ""] },
    "backlight": { "format": "󰃠 {percent}%" },
    "battery": { "format": "{icon} {capacity}%", "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"] },
    "clock": { "format": "󰅐 {:%H:%M}", "interval": 60 }
}
